<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>The puppetty tool: drive CLI/TUI programs in a real terminal from the shell, with sessions kept alive by a background daemon, and `puppetty mcp`, an MCP server that lets AI agents do the same.</Description>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Company>Iciclecreek</Company>
    <Authors>Tom Laird-McConnell</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tomlm/Puppetty</PackageProjectUrl>
    <PackageIconUrl>https://raw.githubusercontent.com/tomlm/Puppetty/master/icon.png</PackageIconUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/tomlm/Puppetty</RepositoryUrl>
    <Copyright>Tom Laird-McConnell All Rights Reserved</Copyright>
    <RootNamespace>Puppetty</RootNamespace>
    <ContentTargetFolders>content</ContentTargetFolders>
    <!-- A tool package is the app's whole publish folder, so .pdb files would go into the .nupkg
         (a .snupkg doesn't keep them out). The tool's own symbols are embedded in its dll instead, so
         stack traces still have line numbers, and no other .pdb is published (see
         ExcludeSymbolsFromToolPackage). -->
    <DebugType>embedded</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PackAsTool>true</PackAsTool>
    <PackageId>Puppetty</PackageId>
    <ToolCommandName>puppetty</ToolCommandName>
    <!-- An app, not a library: the MCP tools' [Description] attributes are their documentation. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PackageOutputPath>./nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- Keeps the .pdb files of referenced projects and packages (native ones can be hundreds of MB)
       out of the publish folder, and so out of the tool package. The build output keeps them. -->
  <Target Name="ExcludeSymbolsFromToolPackage" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>


  <ItemGroup>
    <PackageReference Include="CShell" Version="3.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Puppetty.NET\Puppetty.NET.csproj" />
  </ItemGroup>

</Project>
