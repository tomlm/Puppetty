<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Puppetty.Cli</RootNamespace>
    <Description>Command-line driver for CLI/TUI programs in a real terminal, with sessions kept alive by a background daemon.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>puppetty</ToolCommandName>
    <!-- An app, not a library. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Puppetty.NET\Puppetty.NET.csproj" />
  </ItemGroup>

</Project>
