<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Puppetty</RootNamespace>
    <Description>Drive CLI/TUI programs in a real pseudo-terminal from code: type, press keys, wait for the screen, read it back.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Porta.Pty" Version="2.2.3" />
    <PackageReference Include="XTerm.NET" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Puppetty.Tests" />
  </ItemGroup>

</Project>
