<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Puppetty</RootNamespace>
    <Description>Drive CLI/TUI programs in a real pseudo-terminal from code: type, press keys, click, wait for the screen and read it back. Includes auto-retrying Expect() assertions and golden snapshots for xUnit, NUnit and MSTest.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Porta.Pty" Version="2.2.3" />
    <PackageReference Include="XTerm.NET" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Puppetty.Tests" />
  </ItemGroup>

</Project>
