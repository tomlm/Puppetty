<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Puppetty.Mcp</RootNamespace>
    <Description>MCP server that lets AI agents drive CLI/TUI programs in a real terminal: launch, type, press keys, click, wait and read the screen.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>puppetty-mcp</ToolCommandName>
    <!-- An app, not a library: the [Description] attributes are the tools' documentation. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Puppetty\Puppetty.csproj" />
  </ItemGroup>

</Project>
